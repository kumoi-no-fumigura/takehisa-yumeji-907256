   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "幾山河越えさりゆかば寂しさのはてなむ國ぞ今日も旅ゆく。",
   "sachu": "",
   "poems": []
  },
  {
