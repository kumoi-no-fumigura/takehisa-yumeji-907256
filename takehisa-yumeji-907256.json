    107
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "秋ゆかばたぐひまれなる惡運のいやはかなき身いづちすてなむ。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0100",
