   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "うらみごとたれにせんとにあらねどもかなしきはわがきその白珠。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0102",
