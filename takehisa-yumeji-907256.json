 "blocks": [
  {
   "id": "takehisa-yumeji-907256-0001",
   "pid": "907256",
   "pages": [
    4
   ],
   "no": null,
   "maki": "標題",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "繪入歌集暮笛竹久夢二著東京三陽堂發兌",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0002",
   "pid": "907256",
   "pages": [
    5
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "序この本は、先きに出した「繪入歌集」を增補改版したものです。ここに撰んだ歌は、遠く萬葉から近代にいたる各々の時代の作て、私の記臆に殘つてゐるものだけです。作者の名も今はさだかに覺えぬほど昔に讀みおぼえたものもあるし、また人に知られずに散る名もない一少女の手紙のはしに書きつけてあつた野の花のやうな作もある。それにしても曾てそれ〳〵の時代に、私の心に共鳴しないものはないのです。それゆえ、歌によせた繪にも、平安朝の大宮人が洋傘をかざして銀座の街をゆくもあれば、洋服をきて寧樂の舊都をさまよふ髪長き詩人もある。この時代錯誤も私にはきわめて自然です。この本をよむ人に、この私の我儘な滿足を許して貰ひたい。千九百十六年十一月二十五日京都にて夢二",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0003",
   "pid": "907256",
   "pages": [
    11
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "ほそ〳〵とそこらこゝらに虫のなく晝の野にきてよむ手紙かな。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0004",
   "pid": "907256",
   "pages": [
    12
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "水をみて流るゝ水を見てありぬ日はかくてありもえしかど。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0005",
   "pid": "907256",
   "pages": [
    13
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "かの宵の露臺のことはゆめひこにいひたまふなと言へるきみかな。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0006",
   "pid": "907256",
   "pages": [
    14
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "紫は灰さすものぞ椿市の八十のちまたに逢へる子やたれ。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0007",
   "pid": "907256",
   "pages": [
    15
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "悲しくも母がまつゆえ妹がまつゆえ家に今日もかへらむ。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0008",
   "pid": "907256",
   "pages": [
    16
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "身ごもるこきゝてかなしき妻おもふ無花果の實の靑き八月。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0009",
   "pid": "907256",
   "pages": [
    17
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "鳥とべば君かこぞおもひ風ふかば君かとぞおもふかなしき通ひ路。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0010",
   "pid": "907256",
   "pages": [
    18
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "なげけこていまはた目白僧園の夕の鐘もなりいでにけむ。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0011",
   "pid": "907256",
   "pages": [
    19
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "まつり日や見世物小屋のかたはらの蚊帳釣草にふる夏の雨。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0012",
   "pid": "907256",
   "pages": [
    20
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "花見れば花のかはゆしつみてましつむとも何のなぐさめにせむ。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0013",
   "pid": "907256",
   "pages": [
    21
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "黃昏のよりごころなき魂か柳のかげを蝙蝠のとぶ。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0014",
   "pid": "907256",
   "pages": [
    22
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "片手なき人形ひとつまろびぬる木のかげ靑き子供部屋かな。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0015",
   "pid": "907256",
   "pages": [
    23
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "春の海さして船ゆく山蔭の名もなき港晝の鐘なる。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0016",
   "pid": "907256",
   "pages": [
    24
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "夕ぐれのとりあつめたる靄のうちしづかに人の泣く音きこゆる。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0017",
   "pid": "907256",
   "pages": [
    25
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "問ふまゝに死ぬる藥をおしへやる生きてかひなき夜の女に。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0018",
   "pid": "907256",
   "pages": [
    26
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "おほかたのあはれをしるにおつれごも涙はきみにかけてこそおもへ。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0019",
   "pid": "907256",
   "pages": [
    27
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "晩秋の波止場の道にこぼれたる豆をさびしみかへるたそがれ。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0020",
   "pid": "907256",
   "pages": [
    28
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "戶なひきそ戶の面に今しゆく春のかなしさみてりこよ何か泣く。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0021",
   "pid": "907256",
   "pages": [
    29
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "港入り娼家の壁が落日にかがやけるこそかなしかりけり。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0022",
   "pid": "907256",
   "pages": [
    30
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "いつはしも戀ひぬ昨とはあらねごもゆふかたまけて戀はすべなし。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0023",
   "pid": "907256",
   "pages": [
    31
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "朝なさな草のへしろくおく露のけなばともにといひし君はも。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0024",
   "pid": "907256",
   "pages": [
    32
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "ゆく水に赤き日のさし水ぐるま春の川瀨にやまずめぐるも。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0025",
   "pid": "907256",
   "pages": [
    33
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "わが屋戶の夕蔭草の白露のけぬがにもとなおもほゆるかも。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0026",
   "pid": "907256",
   "pages": [
    34
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "たらちねの母が呼ぶ名をまをさめご道ゆきびとを誰と知りてか。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0027",
   "pid": "907256",
   "pages": [
    35
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "いまはたゞ橇の鈴のみなつかしき雪の戶なれば馬にむちうつ。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0028",
   "pid": "907256",
   "pages": [
    36
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "はたらかば母の氣嫌もなほるかと針とりあげて淚ぬぐへり。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0029",
   "pid": "907256",
   "pages": [
    37
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "頰につたふ涙のごはず一握の砂をしめしゝひとをわすれず。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0030",
   "pid": "907256",
   "pages": [
    38
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "惜めごも春のかぎりの今日の日の夕暮にさへなりにけるかな。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0031",
   "pid": "907256",
   "pages": [
    39
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "はかもなき露のほどにもきえてまし玉となりけんかひもなき身を。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0032",
   "pid": "907256",
   "pages": [
    40
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "いつしかに淺きうき名もたちけらし浮世新道夏のたそがれ。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0033",
   "pid": "907256",
   "pages": [
    41
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "うつせみのつねの言葉とおもへごもつぎてしきけば心はなぎて。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0034",
   "pid": "907256",
   "pages": [
    42
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "桐の花ことにかはゆき半玉の泣かまほしさにあゆむ雨かな。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0035",
   "pid": "907256",
   "pages": [
    43
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "春の夜の夢ばかりなる手枕にかひなくたゝむ名こそをしけれ。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0036",
   "pid": "907256",
   "pages": [
    44
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "すく〳〵とおひたつ麥に腹すりて燕とびくる春の山畑。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0037",
   "pid": "907256",
   "pages": [
    45
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "春の月橡の雨戶のおもからば逢はでかへらむ歌うたへきみ。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0038",
   "pid": "907256",
   "pages": [
    46
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "わすれじのゆく末まではかたけれご今日をかぎりの命さもかな。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0039",
   "pid": "907256",
   "pages": [
    47
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "君おもふあまた男のそのなかのこの櫛挽とおもへば哀しも。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0040",
   "pid": "907256",
   "pages": [
    48
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "越えもせむ越さずもあらん逢坂の關守ならぬ人なとがめそ。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0041",
   "pid": "907256",
   "pages": [
    49
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "その人も泣いてわかれたこの人もないて別れる夏柳かな。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0042",
   "pid": "907256",
   "pages": [
    50
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "うらがなし歸りて君が父のまへいふいひわけのおぼつかなしも。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0043",
   "pid": "907256",
   "pages": [
    51
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "かたく手に抱けば死をも辭しがたき心とぞなる人のかなしも。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0044",
   "pid": "907256",
   "pages": [
    52
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "道のべのいちしの花のいちじろく人みなしりぬわがこひづまは。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0045",
   "pid": "907256",
   "pages": [
    53
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "今をかも萌ゆるかふたりしきてねしその丘のへのいとし若草。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0046",
   "pid": "907256",
   "pages": [
    54
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "ほの〳〵と野のうすみごりうつるなり君が化粧の春の鏡に。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0047",
   "pid": "907256",
   "pages": [
    55
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "ありし日の少女のごとき眼してなせに今宵はむかへくるゝや。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0048",
   "pid": "907256",
   "pages": [
    56
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "ねもごろに片思ひすれこのころのわがこゝろどの生けりともなき。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0049",
   "pid": "907256",
   "pages": [
    57
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "ゆるしたまへ月にあはれをさそはれし夏のひと夜のたはむりなりしを。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0050",
   "pid": "907256",
   "pages": [
    58
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "夏の帶いさごのうへになが〳〵とときてかこちぬ身さへほそると。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0051",
   "pid": "907256",
   "pages": [
    59
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "なにかしらかぞへて折りし手の指の握りしまゝに哀しかりける。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0052",
   "pid": "907256",
   "pages": [
    60
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "あはれまたねむりたまふやたまさかに逢ふ夜はわけて短きものを。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0053",
   "pid": "907256",
   "pages": [
    61
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "またみむはいつの宵ぞもしかすがにつめたくふるゝ黑髪かなし。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0054",
   "pid": "907256",
   "pages": [
    62
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "なにゆゑに戀のはじめにかくばかり悲しきことをきみはのたまふ。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0055",
   "pid": "907256",
   "pages": [
    63
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "何處やらむかすかに蟲のなくごとく心ぼそさを今日もおぼゆる。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0056",
   "pid": "907256",
   "pages": [
    64
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "妹よわれも母をば持たざりきおほかたの日はかなしかりけり。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0057",
   "pid": "907256",
   "pages": [
    65
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "春の夜の月のうちにもかくれまし思ふと君につげ得たるのち。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0058",
   "pid": "907256",
   "pages": [
    66
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "思出もとほき通草のかなし花きみにしらえずちりかすぎなむ。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0059",
   "pid": "907256",
   "pages": [
    67
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "別れむとするかなしみにつながれて逢へばかはゆしすてもかねたる。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0060",
   "pid": "907256",
   "pages": [
    68
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "白芥子よ暮春はものゝ哀しさの身にしみわたり人の戀しき。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0061",
   "pid": "907256",
   "pages": [
    69
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "風なきに緋桃みだる、今宵なりみだれて君の戀しき夜なり。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0062",
   "pid": "907256",
   "pages": [
    70
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "あひそめし日かやわかれの涙かやなけばにるかな心なごみて。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0063",
   "pid": "907256",
   "pages": [
    71
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "戀ふること心やりかねいでてゆけば山をも河をもしらずきにけり。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0064",
   "pid": "907256",
   "pages": [
    72
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "萌えそめし何の芽生ぞ二葉なる芽よりかなしき君とこそおもへ。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0065",
   "pid": "907256",
   "pages": [
    73
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "黒髪のものやわらかきふくらみに吸はれゆくかなわかき心の。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0066",
   "pid": "907256",
   "pages": [
    74
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "村はづれ旅商人の肩の荷にあきつみだれてとべるたそがれ。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0067",
   "pid": "907256",
   "pages": [
    75
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "つゝじさく朝の涙の頬づたひの色としきかばかへりこよ君。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0068",
   "pid": "907256",
   "pages": [
    76
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "かなしくもきみはお七になれどいふいかなるつとめわれこぐべしや。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0069",
   "pid": "907256",
   "pages": [
    77
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "露路のおく酢倉の裏のくらがりに盲人のごとく泣ける三味線。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0070",
   "pid": "907256",
   "pages": [
    78
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "鉦ならし信濃の國をゆきゆかばありしながらの母みるらんか。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0071",
   "pid": "907256",
   "pages": [
    79
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "いつとなくわするゝとなく文たえてあはれことしの夏もいぬめり。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0072",
   "pid": "907256",
   "pages": [
    80
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "たけばぬれたかねばながき妹が髪このごろみねばみだれつらんか。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0073",
   "pid": "907256",
   "pages": [
    81
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "鐵橋を白くぬりかへし寂しさよこの大川の秋の夕暮。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0074",
   "pid": "907256",
   "pages": [
    82
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "初秋や水のやうなる風吹けば髪も袂もまかせてぞたつ。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0075",
   "pid": "907256",
   "pages": [
    83
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "ゆく秋の山の谷々わが母はいかにさびしく住みたまふらむ。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0076",
   "pid": "907256",
   "pages": [
    84
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "茶がかりし中折帽を手にもちてものを言ひたる人は悲しも。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0077",
   "pid": "907256",
   "pages": [
    85
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "いつしらず身は公園の掛椅子に夜をまつ人となりにけらしな。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0078",
   "pid": "907256",
   "pages": [
    86
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "つかの間に帯をしとけば夏の海うれしく光り肌は白しも。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0079",
   "pid": "907256",
   "pages": [
    87
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "春の風海より吹けば露臺なるわが黒髪のそよらとなるも。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0080",
   "pid": "907256",
   "pages": [
    88
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "そゝろにもすぎし思ひのいとほしく夜のねざめも秋はかなしき。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0081",
   "pid": "907256",
   "pages": [
    89
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "よき椅子に黒き猫さへきてなげく初夏晩春の濃きコヽアかな。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0082",
   "pid": "907256",
   "pages": [
    90
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "函館にゆかばやせめてみちのくのほのみゆる日もあるべし皐月。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0083",
   "pid": "907256",
   "pages": [
    91
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "筑波根の峰の白雪ありやなしやさやかに雁のなきつれてゆく。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0084",
   "pid": "907256",
   "pages": [
    92
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "深川の夏の夜こひし船唄の木の香にまじり水のながるゝ。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0085",
   "pid": "907256",
   "pages": [
    93
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "泣きぬれて今來しものをあはれとも驕きもせで相見る人よ。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0086",
   "pid": "907256",
   "pages": [
    94
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "茜さす紫野ゆき標野ゆき野守はみずやきみが袖ふる。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0087",
   "pid": "907256",
   "pages": [
    95
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "圓山の長椅子に凭りてあはれにも娼婦のあそぶ春のゆふぐれ。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0088",
   "pid": "907256",
   "pages": [
    96
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "わがせこはせどのあさ川かちわたり菖蒲荷ひて都べにゆく。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0089",
   "pid": "907256",
   "pages": [
    97
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "厨女の白き前掛しみ〳〵と青葱の香のしみて雪ふる。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0090",
   "pid": "907256",
   "pages": [
    98
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "橘のかげふむ路の八衢にものをぞおもふ妹に逢はずて。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0091",
   "pid": "907256",
   "pages": [
    99
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "いつしかに春の名残となりにけり昆布干場のたんばゝの花。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0092",
   "pid": "907256",
   "pages": [
    100
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "わが背子を大和へやると小夜ふけてあかつき露にわがたちぬれし。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0093",
   "pid": "907256",
   "pages": [
    101
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "ぬばたまの黒髪山の山菅に小雨ふりしきしく〳〵おもほゆ。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0094",
   "pid": "907256",
   "pages": [
    102
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "とのもには雪ふりけらし潮鳴のひま〳〵にきく濱千鳥かな。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0095",
   "pid": "907256",
   "pages": [
    103
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "目もはるに秋の野のへをわたる鳥その鳥のごと旅にいでまし。",
   "sachu": "",
   "poems": []
  },
  {
   "id": "takehisa-yumeji-907256-0096",
   "pid": "907256",
   "pages": [
    104
   ],
   "no": null,
   "maki": "序",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "頬かぶりの男と肩をならべゆ〳〵和泉の國の秋風の路。",
   "sachu": "",
   "poems": []
  },
  {
